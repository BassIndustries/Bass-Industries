/* =========================
   BASIC RESET
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #222;
    background: #ffffff;
    line-height: 1.6;
}


/* =========================
   NAVIGATION
========================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 100;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 15px 5%;

    background: white;
    border-bottom: 1px solid #ddd;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;

    font-size: 1.2rem;
    font-weight: bold;
}

.logo img {
    width: 45px;
    height: 45px;

    object-fit: cover;
    border-radius: 50%;
}

.navbar nav {
    display: flex;
    align-items: center;
    gap: 20px;
}

.navbar a {
    color: #222;
    text-decoration: none;
    font-weight: 500;
}

.navbar a:hover {
    color: #777;
}

.cart-button {
    border: none;
    background: #111;
    color: white;

    padding: 10px 16px;

    border-radius: 6px;

    cursor: pointer;
}

.cart-button:hover {
    background: #333;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 600px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    align-items: center;

    background: #f5f5f5;
}

.hero-image {
    height: 100%;
}

.hero-image img {
    width: 100%;
    height: 100%;

    min-height: 600px;

    object-fit: cover;
}

.hero-content {
    padding: 60px;
}

.hero-content h1 {
    font-size: 3rem;
    margin-bottom: 20px;
}

.hero-content p {
    max-width: 500px;
    margin-bottom: 30px;

    font-size: 1.1rem;
    color: #555;
}


/* =========================
   BUTTONS
========================= */

.button {
    display: inline-block;

    background: #111;
    color: white;

    padding: 13px 25px;

    border-radius: 6px;

    text-decoration: none;

    font-weight: bold;
}

.button:hover {
    background: #333;
}


/* =========================
   ABOUT
========================= */

.about {
    max-width: 900px;

    margin: auto;

    padding: 80px 25px;

    text-align: center;
}

.about h2 {
    font-size: 2rem;
    margin-bottom: 20px;
}

.about p {
    color: #666;
}


/* =========================
   SHOP
========================= */

.shop {
    padding: 80px 5%;

    background: #fafafa;
}

.section-heading {
    text-align: center;

    margin-bottom: 50px;
}

.section-heading h2 {
    font-size: 2.5rem;
}

.section-heading p {
    color: #666;
}


/* =========================
   PRODUCT GRID
========================= */

.product-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));

    gap: 30px;

    max-width: 1400px;

    margin: auto;
}


/* =========================
   PRODUCT CARD
========================= */

.product-card {
    background: white;

    border-radius: 10px;

    overflow: hidden;

    box-shadow: 0 3px 15px rgba(0,0,0,0.08);

    transition: transform 0.2s;
}

.product-card:hover {
    transform: translateY(-5px);
}

.product-image {
    width: 100%;
    height: 250px;

    object-fit: cover;
}

.product-info {
    padding: 20px;
}

.product-info h3 {
    margin-bottom: 8px;

    font-size: 1.2rem;
}

.product-description {
    color: #666;

    font-size: 0.95rem;

    margin-bottom: 15px;
}

.product-price {
    font-size: 1.2rem;

    font-weight: bold;

    margin-bottom: 15px;
}

.add-button {
    width: 100%;

    border: none;

    background: #111;
    color: white;

    padding: 12px;

    border-radius: 6px;

    cursor: pointer;

    font-weight: bold;
}

.add-button:hover {
    background: #333;
}


/* =========================
   SHOPPING CART
========================= */

.cart-overlay {
    display: none;

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,0.4);

    z-index: 199;
}

.cart-overlay.active {
    display: block;
}

.cart {
    position: fixed;

    top: 0;
    right: -420px;

    width: 400px;
    max-width: 90%;

    height: 100vh;

    background: white;

    z-index: 200;

    display: flex;
    flex-direction: column;

    transition: right 0.3s;
}

.cart.open {
    right: 0;
}

.cart-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 20px;

    border-bottom: 1px solid #ddd;
}

.close-button {
    border: none;

    background: none;

    font-size: 2rem;

    cursor: pointer;
}

.cart-items {
    flex: 1;

    overflow-y: auto;

    padding: 20px;
}

.cart-item {
    display: grid;

    grid-template-columns: 70px 1fr;

    gap: 15px;

    padding: 15px 0;

    border-bottom: 1px solid #ddd;
}

.cart-item img {
    width: 70px;
    height: 70px;

    object-fit: cover;

    border-radius: 6px;
}

.cart-item h4 {
    margin-bottom: 5px;
}

.cart-item-price {
    color: #555;
}

.quantity-controls {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 8px;
}

.quantity-controls button {
    width: 25px;
    height: 25px;

    border: 1px solid #ccc;

    background: white;

    cursor: pointer;
}

.remove-button {
    border: none;

    background: none;

    color: #c00;

    cursor: pointer;

    margin-top: 5px;
}

.cart-footer {
    padding: 20px;

    border-top: 1px solid #ddd;
}

.cart-total {
    display: flex;

    justify-content: space-between;

    font-size: 1.2rem;

    margin-bottom: 20px;
}

.checkout-button {
    width: 100%;

    padding: 15px;

    border: none;

    border-radius: 6px;

    background: #ffc439;

    color: #111;

    font-weight: bold;

    cursor: pointer;
}

.checkout-button:hover {
    background: #ffb900;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 30px;

    text-align: center;

    background: #111;

    color: white;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    .navbar {
        flex-direction: column;

        gap: 15px;
    }

    .navbar nav {
        gap: 12px;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .hero-image img {
        min-height: 350px;
    }

    .hero-content {
        padding: 40px 25px;
    }

    .hero-content h1 {
        font-size: 2.2rem;
    }

    .cart {
        width: 100%;
        max-width: 100%;
    }

}
