{
box-sizing: border-box;
margin: 0;
padding: 0;
}

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, Helvetica, sans-serif;
background: #ffffff;
color: #080808;
line-height: 1.5;
}

img {
display: block;
max-width: 100%;
}

a {
color: inherit;
text-decoration: none;
}

/* ================================
HEADER
================================ */

.site-header {
position: sticky;
top: 0;
z-index: 100;
min-height: 76px;
padding: 0 5%;
display: flex;
align-items: center;
justify-content: space-between;
background: #ffffff;
border-bottom: 1px solid #dddddd;
}

.logo {
font-size: 17px;
font-weight: 900;
letter-spacing: 3px;
}

.main-nav {
display: flex;
align-items: center;
gap: 28px;
font-size: 11px;
font-weight: 800;
letter-spacing: 1.5px;
}

.main-nav a:hover {
color: #777777;
}

.cart-button {
border: none;
background: #000000;
color: #ffffff;
padding: 12px 18px;
cursor: pointer;
font-size: 10px;
font-weight: 800;
letter-spacing: 1px;
}

.cart-button span {
margin-left: 5px;
}

/* ================================
HERO
================================ */

.hero {
position: relative;
height: 680px;
overflow: hidden;
background: #000000;
color: #ffffff;
}

.hero-image {
position: absolute;
inset: 0;
}

.hero-image img {
width: 100%;
height: 100%;
object-fit: cover;
filter: grayscale(100%);
}

.hero-overlay {
position: absolute;
inset: 0;
background: linear-gradient(
90deg,
rgba(0, 0, 0, 0.9),
rgba(0, 0, 0, 0.5),
rgba(0, 0, 0, 0.15)
);
}

.hero-content {
position: relative;
z-index: 2;
max-width: 700px;
padding: 175px 5%;
}

.eyebrow {
font-size: 10px;
font-weight: 900;
letter-spacing: 3px;
margin-bottom: 18px;
}

.hero h1 {
font-size: clamp(4rem, 9vw, 8rem);
line-height: 0.84;
letter-spacing: -6px;
margin-bottom: 35px;
}

.hero-content > p:not(.eyebrow) {
max-width: 500px;
color: #dddddd;
font-size: 17px;
margin-bottom: 35px;
}

/* ================================
BUTTONS
================================ */

.primary-button {
display: inline-block;
background: #ffffff;
color: #000000;
padding: 16px 26px;
font-size: 11px;
font-weight: 900;
letter-spacing: 2px;
}

.primary-button:hover {
background: #dddddd;
}

.secondary-button {
display: inline-block;
border: 1px solid #ffffff;
color: #ffffff;
padding: 14px 24px;
font-size: 10px;
font-weight: 900;
letter-spacing: 2px;
}

.secondary-button:hover {
background: #ffffff;
color: #000000;
}

/* ================================
SECTIONS
================================ */

.featured-section,
.categories-section {
padding: 100px 5%;
}

.section-heading {
max-width: 1400px;
margin: 0 auto 45px;
display: flex;
justify-content: space-between;
align-items: flex-end;
}

.section-heading h2 {
font-size: clamp(2.2rem, 5vw, 4.5rem);
line-height: 0.9;
letter-spacing: -3px;
}

.centered {
display: block;
text-align: center;
}

.view-link {
font-size: 10px;
font-weight: 900;
letter-spacing: 1.5px;
}

.view-link:hover {
text-decoration: underline;
}

/* ================================
PRODUCTS
================================ */

.product-grid {
max-width: 1400px;
margin: 0 auto;
display: grid;
grid-template-columns: repeat(
auto-fit,
minmax(260px, 1fr)
);
gap: 25px;
}

.product-card {
background: #f2f2f2;
overflow: hidden;
}

.product-card-image {
width: 100%;
aspect-ratio: 1 / 1;
object-fit: cover;
filter: grayscale(100%);
transition: transform 0.4s ease;
}

.product-card:hover .product-card-image {
transform: scale(1.04);
}

.product-card-info {
padding: 20px;
background: #ffffff;
}

.product-card-category {
font-size: 9px;
font-weight: 900;
letter-spacing: 2px;
color: #777777;
margin-bottom: 7px;
}

.product-card h3 {
font-size: 17px;
margin-bottom: 7px;
}

.product-card-part {
font-size: 10px;
color: #777777;
margin-bottom: 15px;
}

.product-card-bottom {
display: flex;
justify-content: space-between;
align-items: center;
}

.product-price {
font-size: 17px;
font-weight: 900;
}

.quick-add {
border: none;
background: #000000;
color: #ffffff;
padding: 10px 14px;
cursor: pointer;
font-size: 9px;
font-weight: 900;
letter-spacing: 1px;
}

.quick-add:hover {
background: #333333;
}

/* ================================
ABOUT
================================ */

.about-section {
display: grid;
grid-template-columns: 1fr 1fr;
min-height: 600px;
background: #000000;
color: #ffffff;
}

.about-image {
min-height: 500px;
}

.about-image img {
width: 100%;
height: 100%;
object-fit: cover;
filter: grayscale(100%);
}

.about-content {
display: flex;
flex-direction: column;
justify-content: center;
padding: 10%;
}

.about-content h2 {
font-size: clamp(2.5rem, 5vw, 5rem);
line-height: 0.92;
letter-spacing: -4px;
margin-bottom: 30px;
}

.about-content > p:not(.eyebrow) {
max-width: 500px;
color: #bbbbbb;
margin-bottom: 35px;
}

/* ================================
CATEGORIES
================================ */

.category-grid {
max-width: 1400px;
margin: 0 auto;
display: grid;
grid-template-columns: repeat(4, 1fr);
border-top: 1px solid #cccccc;
}

.category-card {
min-height: 260px;
padding: 30px;
border-right: 1px solid #cccccc;
border-bottom: 1px solid #cccccc;
transition: background 0.25s, color 0.25s;
}

.category-card:last-child {
border-right: none;
}

.category-card span {
font-size: 10px;
color: #777777;
}

.category-card h3 {
margin-top: 80px;
font-size: 24px;
}

.category-card p {
color: #777777;
font-size: 11px;
}

.category-card:hover {
background: #000000;
color: #ffffff;
}

.category-card:hover p {
color: #aaaaaa;
}

/* ================================
CART
================================ */

.cart-overlay {
position: fixed;
inset: 0;
z-index: 199;
background: rgba(0, 0, 0, 0.55);
display: none;
}

.cart-overlay.active {
display: block;
}

.cart {
position: fixed;
top: 0;
right: -450px;
z-index: 200;
width: 430px;
max-width: 90%;
height: 100vh;
background: #ffffff;
display: flex;
flex-direction: column;
transition: right 0.3s ease;
}

.cart.open {
right: 0;
}

.cart-header {
display: flex;
justify-content: space-between;
align-items: center;
padding: 25px;
border-bottom: 1px solid #dddddd;
}

.cart-header h2 {
font-size: 13px;
letter-spacing: 2px;
}

.close-cart {
border: none;
background: none;
font-size: 30px;
cursor: pointer;
}

.cart-items {
flex: 1;
overflow-y: auto;
padding: 20px;
}

.cart-item {
display: grid;
grid-template-columns: 75px 1fr;
gap: 15px;
padding: 15px 0;
border-bottom: 1px solid #dddddd;
}

.cart-item img {
width: 75px;
height: 75px;
object-fit: cover;
}

.cart-item h4 {
font-size: 13px;
}

.cart-item-price {
font-size: 12px;
color: #666666;
margin-top: 4px;
}

.quantity-controls {
display: flex;
align-items: center;
gap: 10px;
margin-top: 10px;
}

.quantity-controls button {
width: 25px;
height: 25px;
border: 1px solid #cccccc;
background: #ffffff;
cursor: pointer;
}

.remove-button {
border: none;
background: none;
color: #888888;
font-size: 9px;
cursor: pointer;
margin-top: 7px;
}

.cart-footer {
border-top: 1px solid #dddddd;
padding: 25px;
}

.cart-total {
display: flex;
justify-content: space-between;
margin-bottom: 20px;
font-size: 13px;
}

.checkout-button {
width: 100%;
padding: 17px;
border: none;
background: #000000;
color: #ffffff;
font-weight: 900;
letter-spacing: 2px;
cursor: pointer;
}

.checkout-button:hover {
background: #333333;
}

/* ================================
FOOTER
================================ */

.site-footer {
background: #000000;
color: #ffffff;
padding: 60px 5%;
display: flex;
justify-content: space-between;
gap: 30px;
}

.site-footer h3 {
font-size: 14px;
letter-spacing: 2px;
margin-bottom: 10px;
}

.site-footer p {
color: #888888;
font-size: 11px;
}

.footer-links {
display: flex;
gap: 25px;
font-size: 10px;
font-weight: 700;
}

.footer-links a:hover {
color: #888888;
}

.copyright {
color: #666666;
font-size: 10px;
}

/* ================================
MOBILE
================================ */

@media (max-width: 800px) {

.site-header {
    padding: 15px 5%;
    flex-wrap: wrap;
    gap: 15px;
}

.main-nav {
    width: 100%;
    justify-content: space-between;
    gap: 12px;
}

.hero {
    height: 600px;
}

.hero-content {
    padding: 140px 7%;
}

.hero h1 {
    letter-spacing: -4px;
}

.section-heading {
    display: block;
}

.view-link {
    display: inline-block;
    margin-top: 20px;
}

.about-section {
    grid-template-columns: 1fr;
}

.about-image {
    height: 400px;
}

.category-grid {
    grid-template-columns: 1fr 1fr;
}

.category-card {
    border-right: 1px solid #cccccc;
}

.site-footer {
    flex-direction: column;
}


}

@media (max-width: 500px) {

.logo {
    font-size: 13px;
}

.main-nav {
    font-size: 9px;
}

.hero h1 {
    font-size: 4rem;
}

.category-grid {
    grid-template-columns: 1fr;
}

.category-card {
    min-height: 180px;
}

.category-card h3 {
    margin-top: 45px;
}


}
